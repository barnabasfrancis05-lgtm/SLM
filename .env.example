MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/student_life_manager
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
# Exact Netlify URL when frontend and backend are on different domains:
FRONTEND_ORIGIN=https://your-site.netlify.app
NODE_ENV=production
# SMTP settings for real-time password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=Student Life Manager <your-email@gmail.com>
